{
  "name": "jarvis-hub",
  "version": "1.0.0",
  "private": true,
  "description": "JARVIS Hub & Spoke multi-agent infrastructure",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/api/server.ts",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "build": "tsc -p tsconfig.json && npm --prefix dashboard run build",
    "start": "node dist/api/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nanoid": "^5.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
